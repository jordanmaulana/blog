---
import type { CollectionEntry } from "astro:content";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { render } from "astro:content";

interface Props {
  entry: CollectionEntry<"gears">;
  ogImage: ImageMetadata | null;
}

const { entry, ogImage } = Astro.props;
const { name, url } = entry.data;
const { Content } = await render(entry);
---

<article
  class="group flex flex-col overflow-hidden rounded-(--radius-card) border border-border bg-bg-soft/40 transition hover:border-accent hover:shadow-lg hover:shadow-(--color-accent)/10"
>
  <a
    href={url}
    target="_blank"
    rel="sponsored noopener noreferrer"
    class="relative block aspect-video overflow-hidden bg-bg-soft"
    aria-label={name}
  >
    {
      ogImage ? (
        <Image
          src={ogImage}
          alt={name}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition group-hover:scale-[1.02]"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center font-mono text-xs uppercase tracking-[0.25em] text-fg-soft">
          no preview
        </div>
      )
    }
  </a>
  <div class="flex flex-1 flex-col gap-2 p-5">
    <header class="flex items-start justify-between gap-3">
      <a
        href={url}
        target="_blank"
        rel="sponsored noopener noreferrer"
        class="text-base font-semibold tracking-tight transition hover:text-accent"
      >
        {name}
      </a>
      <span aria-hidden="true" class="text-fg-soft">↗</span>
    </header>
    <div
      class="prose prose-sm prose-invert max-w-none text-sm text-fg-soft prose-a:text-accent prose-strong:text-fg prose-p:my-0 prose-ul:my-1"
    >
      <Content />
    </div>
  </div>
</article>
