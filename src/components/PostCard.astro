---
import type { CollectionEntry } from "astro:content";
import { formatDate, getLangFromUrl, localizedPath } from "~/i18n/utils";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const slug = post.id.replace(/\.mdx?$/, "");
const href = localizedPath(lang, `/blog/${slug}`);
---

<article class="group">
  <a
    href={href}
    class="block rounded-(--radius-card) border border-border bg-bg-soft/40 px-5 py-4 transition hover:border-accent hover:bg-bg-soft/70"
  >
    <header class="flex items-baseline justify-between gap-3">
      <h3
        class="text-base font-semibold tracking-tight transition group-hover:text-accent"
      >
        {post.data.title}
      </h3>
      <time
        datetime={post.data.pubDate.toISOString()}
        class="shrink-0 font-mono text-xs text-fg-soft"
      >
        {formatDate(post.data.pubDate, lang)}
      </time>
    </header>
    <p class="mt-1.5 text-sm text-fg-soft">{post.data.description}</p>
    {
      post.data.tags.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-1.5">
          {post.data.tags.map((tag) => (
            <li class="font-mono text-[10px] uppercase tracking-wider text-fg-soft/80">
              #{tag}
            </li>
          ))}
        </ul>
      )
    }
  </a>
</article>
