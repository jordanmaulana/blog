---
import type { CollectionEntry } from "astro:content";
import { getLangFromUrl, localizedPath, useTranslations } from "~/i18n/utils";

interface Props {
  product: CollectionEntry<"products">;
}

const { product } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { name, tagline, url, stack, status } = product.data;
const href = localizedPath(lang, `/products/${product.id}`);

const statusClass: Record<typeof status, string> = {
  live: "bg-[var(--color-accent)]/15 text-[var(--color-accent)]",
  prototype: "bg-yellow-400/15 text-yellow-300",
  wip: "bg-blue-400/15 text-blue-300",
};
---

<article class="group relative flex flex-col gap-4 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-bg-soft)]/40 p-6 transition hover:border-[var(--color-accent)] hover:shadow-lg hover:shadow-[var(--color-accent)]/10">
  <header class="flex items-start justify-between gap-3">
    <a href={href} class="text-lg font-semibold tracking-tight after:absolute after:inset-0">
      {name}
    </a>
    <span class={`shrink-0 rounded-full px-2 py-1 text-[10px] font-medium uppercase tracking-wider ${statusClass[status]}`}>
      {status}
    </span>
  </header>
  <p class="text-sm text-[var(--color-fg-soft)]">{tagline}</p>
  {
    stack.length > 0 && (
      <ul class="flex flex-wrap gap-1.5">
        {stack.slice(0, 5).map((s) => (
          <li class="rounded-full border border-[var(--color-border)] px-2 py-0.5 font-mono text-[10px] text-[var(--color-fg-soft)]">
            {s}
          </li>
        ))}
      </ul>
    )
  }
  <footer class="mt-auto flex items-center justify-between text-xs text-[var(--color-fg-soft)]">
    <span class="font-mono">{t("products.read")}</span>
    {
      url && (
        <a
          href={url}
          target="_blank"
          rel="noreferrer"
          class="relative z-10 transition hover:text-[var(--color-accent)]"
        >
          {t("products.visit")}
        </a>
      )
    }
  </footer>
</article>
