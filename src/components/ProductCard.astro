---
import type { CollectionEntry } from "astro:content";
import { getLangFromUrl, localizedPath, useTranslations } from "~/i18n/utils";

interface Props {
  product: CollectionEntry<"products">;
}

const { product } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { name, tagline, url, stack, status } = product.data;
const href = localizedPath(lang, `/products/${product.id}`);

const statusClass: Record<typeof status, string> = {
  live: "bg-accent/15 text-accent",
  prototype: "bg-yellow-400/15 text-yellow-300",
  wip: "bg-blue-400/15 text-blue-300",
};
---

<article
  class="group relative flex flex-col gap-4 rounded-(--radius-card) border border-border bg-bg-soft/40 p-6 transition hover:border-accent hover:shadow-lg hover:shadow-(--color-accent)/10"
>
  <header class="flex items-start justify-between gap-3">
    <a
      href={href}
      class="text-lg font-semibold tracking-tight after:absolute after:inset-0"
    >
      {name}
    </a>
    <span
      class={`shrink-0 rounded-full px-2 py-1 text-[10px] font-medium uppercase tracking-wider ${statusClass[status]}`}
    >
      {status}
    </span>
  </header>
  <p class="text-sm text-fg-soft">{tagline}</p>
  {
    stack.length > 0 && (
      <ul class="flex flex-wrap gap-1.5">
        {stack.slice(0, 5).map((s) => (
          <li class="rounded-full border border-border px-2 py-0.5 font-mono text-[10px] text-fg-soft">
            {s}
          </li>
        ))}
      </ul>
    )
  }
  <footer
    class="mt-auto flex items-center justify-between gap-3 text-xs text-fg-soft"
  >
    <span class="font-mono">{t("products.read")}</span>
    {
      url &&
        (status === "prototype" ? (
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            class="relative z-10 rounded-full bg-accent px-3 py-1.5 font-medium text-accent-fg transition hover:opacity-90"
          >
            {t("products.try")}
          </a>
        ) : (
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            class="relative z-10 transition hover:text-accent"
          >
            {t("products.visit")}
          </a>
        ))
    }
  </footer>
</article>
