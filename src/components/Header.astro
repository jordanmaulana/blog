---
import { getLangFromUrl, localizedPath, useTranslations } from "~/i18n/utils";
import LangSwitcher from "./LangSwitcher.astro";
import ThemeToggle from "./ThemeToggle.tsx";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const home = localizedPath(lang, "/");

// Inner markup for a shared 24x24 stroke icon frame.
const icons = {
  home: '<path d="M3 10.6 12 3l9 7.6V21H3z" /><path d="M9.5 21v-6h5v6" />',
  user: '<circle cx="12" cy="8" r="4" /><path d="M4.5 21a7.5 7.5 0 0 1 15 0" />',
  briefcase:
    '<rect x="2.5" y="7" width="19" height="13" rx="2" /><path d="M8.5 7V5.5a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2V7" />',
  package:
    '<path d="M20.5 8 12 3.5 3.5 8v8L12 20.5l8.5-4.5z" /><path d="M3.5 8 12 12.5 20.5 8" /><path d="M12 12.5v8" />',
  cpu: '<rect x="6.5" y="6.5" width="11" height="11" rx="2" /><path d="M9.5 3v3.5M14.5 3v3.5M9.5 17.5V21M14.5 17.5V21M3 9.5h3.5M3 14.5h3.5M17.5 9.5H21M17.5 14.5H21" />',
  bag: '<path d="M6.5 3h11l2 4v12a2 2 0 0 1-2 2h-11a2 2 0 0 1-2-2V7z" /><path d="M4.5 7h15" /><path d="M15.5 11a3.5 3.5 0 0 1-7 0" />',
  pen: '<path d="M12 20h9" /><path d="M16.4 3.6a2.1 2.1 0 0 1 3 3L7.5 18.5l-4 1 1-4z" />',
} as const;

const navItems: { href: string; label: string; icon: keyof typeof icons }[] = [
  { href: home, label: t("nav.home"), icon: "home" },
  { href: localizedPath(lang, "/about"), label: t("nav.about"), icon: "user" },
  {
    href: localizedPath(lang, "/work"),
    label: t("nav.work"),
    icon: "briefcase",
  },
  {
    href: localizedPath(lang, "/products"),
    label: t("nav.products"),
    icon: "package",
  },
  { href: localizedPath(lang, "/gears"), label: t("nav.gears"), icon: "cpu" },
  { href: localizedPath(lang, "/lapak"), label: t("nav.lapak"), icon: "bag" },
  { href: localizedPath(lang, "/blog"), label: t("nav.blog"), icon: "pen" },
];

const current = Astro.url.pathname.replace(/\/$/, "") || "/";

const isActive = (href: string) => {
  const itemPath = href.replace(/\/$/, "") || "/";
  if (itemPath === current) return true;
  // Home is "/id" in Indonesian, so a prefix match would light it up on every
  // /id/* page. Match it exactly instead.
  if (itemPath === home) return false;
  return current.startsWith(`${itemPath}/`);
};

// Shared by the drawer (<lg) and the rail (lg+) so the two can't drift.
const linkBase =
  "flex items-center gap-3 rounded-lg px-3 py-2.5 text-fg-soft transition hover:bg-bg-soft hover:text-fg";
const linkActive = "bg-bg-soft text-fg";
const iconClass = "h-[18px] w-[18px] shrink-0";
---

<header class="sticky top-0 z-40 border-b border-border/60">
  {/* backdrop-filter makes an element a containing block for position:fixed
      descendants, so it lives on this layer instead of on <header> — the
      drawer panel and the rail both need the viewport as containing block. */}
  <div
    class="absolute inset-0 -z-10 bg-bg/80 backdrop-blur supports-backdrop-filter:bg-bg/60"
  >
  </div>
  {/* Centred with the content column below lg; edge-to-edge on lg+ so the
      wordmark lines up with the rail's icons instead of floating over them. */}
  <div
    class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-6 py-4 lg:max-w-none"
  >
    <div class="flex items-center gap-3">
      <details id="nav-drawer" class="nav-drawer lg:hidden">
        <summary
          class="grid h-9 w-9 cursor-pointer place-items-center rounded-full border border-border bg-bg-soft text-fg-soft transition hover:text-fg"
          aria-label={t("nav.menu")}
        >
          <svg
            class="nav-icon-open h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
          <svg
            class="nav-icon-close h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </summary>

        <div
          class="nav-drawer-panel fixed left-0 z-50 flex w-72 max-w-[80vw] flex-col overflow-y-auto border-r border-border bg-bg px-6 py-6"
        >
          <nav aria-label={t("nav.menu")} class="flex flex-col gap-1 text-sm">
            {
              navItems.map((item) => {
                const active = isActive(item.href);
                return (
                  <a
                    href={item.href}
                    aria-current={active ? "page" : undefined}
                    class:list={[linkBase, active && linkActive]}
                  >
                    <svg
                      class={iconClass}
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      set:html={icons[item.icon]}
                    />
                    <span>{item.label}</span>
                  </a>
                );
              })
            }
          </nav>
        </div>
      </details>

      <a href={home} class="font-mono text-sm font-semibold tracking-tight">
        jordan<span class="text-accent">.</span>maulana
      </a>
    </div>
    <div class="flex items-center gap-2">
      <LangSwitcher />
      <ThemeToggle client:load label={t("theme.toggle")} />
    </div>
  </div>
</header>

{/* Permanent rail, lg+ only. Lives at <body> level (outside <header>) so its
    fixed positioning resolves against the viewport, not the blurred bar. */}
<aside
  id="site-rail"
  class="fixed bottom-0 left-0 z-30 hidden flex-col border-r border-border bg-bg lg:flex"
  style="top: var(--header-h)"
  aria-label={t("nav.menu")}
>
  {/* Bookmark tab riding the right border. Sits outside the scrolling box
      below so overflow-x doesn't clip it; first in DOM so keyboard focus
      order matches the visual top-down order. */}
  <button
    id="rail-toggle"
    type="button"
    aria-controls="site-rail"
    aria-expanded="true"
    aria-label={t("nav.railToggle")}
    title={t("nav.railToggle")}
    class="absolute left-full top-6 grid h-10 w-6 place-items-center rounded-r-lg border border-l-0 border-border bg-bg-soft text-fg-soft transition hover:text-fg"
  >
    <svg
      class="rail-chevron h-4 w-4 transition-[rotate] duration-200"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M11 17 6 12l5-5"></path>
      <path d="M18 17l-5-5 5-5"></path>
    </svg>
  </button>

  <div class="flex-1 overflow-y-auto overflow-x-hidden px-3 py-6">
    <nav class="flex flex-col gap-1 text-sm">
    {
      navItems.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            title={item.label}
            aria-current={active ? "page" : undefined}
            class:list={["rail-link", linkBase, active && linkActive]}
          >
            <svg
              class={iconClass}
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={icons[item.icon]}
            />
            <span class="rail-label whitespace-nowrap">{item.label}</span>
          </a>
        );
      })
    }
    </nav>
  </div>
</aside>

<script is:inline>
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    const drawer = document.getElementById("nav-drawer");
    if (!drawer || !drawer.open) return;
    drawer.open = false;
    drawer.querySelector("summary")?.focus();
  });

  // Rail collapse. The initial data-rail is set pre-paint in BaseLayout's head
  // script; this only keeps aria-expanded honest and handles the click.
  (() => {
    const root = document.documentElement;
    const toggle = document.getElementById("rail-toggle");
    if (!toggle) return;
    const sync = () =>
      toggle.setAttribute(
        "aria-expanded",
        String(root.dataset.rail !== "collapsed"),
      );
    sync();
    toggle.addEventListener("click", () => {
      const collapsed = root.dataset.rail === "collapsed";
      if (collapsed) delete root.dataset.rail;
      else root.dataset.rail = "collapsed";
      try {
        localStorage.setItem("rail", collapsed ? "expanded" : "collapsed");
      } catch {
        /* noop */
      }
      sync();
    });
  })();
</script>
