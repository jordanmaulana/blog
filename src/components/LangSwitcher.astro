---
import { getLangFromUrl, otherLang, switchLangPath, useTranslations } from "~/i18n/utils";
import { localeLabels } from "~/i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const target = otherLang(lang);
const href = switchLangPath(Astro.url, target);
---

<a
  href={href}
  aria-label={t("lang.switchTo")}
  title={t("lang.switchTo")}
  class="inline-flex h-9 items-center gap-1 rounded-full border border-[var(--color-border)] bg-[var(--color-bg-soft)] px-3 text-xs font-medium uppercase tracking-wider text-[var(--color-fg-soft)] transition hover:border-[var(--color-accent)] hover:text-[var(--color-fg)]"
>
  <span>{localeLabels[lang]}</span>
  <span aria-hidden="true">→</span>
  <span>{localeLabels[target]}</span>
</a>
