---
import { getLangFromUrl, useTranslations } from "~/i18n/utils";
import { socials } from "~/data/socials";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
// Set PUBLIC_TIPJAR_URL to your Trakteer / Saweria / Ko-fi link to show a tip jar.
const tipjarUrl = import.meta.env.PUBLIC_TIPJAR_URL;
---

<footer class="border-t border-border/60 mt-24">
  <div
    class="mx-auto max-w-5xl px-6 py-10 flex flex-col gap-6 text-sm text-fg-soft md:flex-row md:items-center md:justify-between"
  >
    <div>
      <p>© {year} Jordan Maulana</p>
      <p class="mt-1 text-xs">{t("footer.copy")}</p>
      {
        tipjarUrl && (
          <a
            href={tipjarUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-2 inline-block text-xs text-accent transition hover:opacity-80"
          >
            {t("footer.tip")}
          </a>
        )
      }
    </div>
    <ul class="flex flex-wrap gap-x-4 gap-y-2">
      {
        socials.map((s) => (
          <li>
            <a
              href={s.url}
              target="_blank"
              rel="noreferrer"
              class="transition hover:text-fg"
            >
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
