---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { getLangFromUrl, localizedPath, useTranslations } from "~/i18n/utils";
import { formatIDR } from "~/utils/format";

interface Props {
  item: CollectionEntry<"lapak">;
  loading?: "eager" | "lazy";
}

const { item, loading = "lazy" } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { name, tagline, price, negotiable, condition, status, photos } = item.data;
const href = localizedPath(lang, `/lapak/${item.id}`);

const statusClass: Record<typeof status, string> = {
  available: "bg-[var(--color-accent)]/15 text-[var(--color-accent)]",
  reserved: "bg-yellow-400/15 text-yellow-300",
  sold: "bg-red-400/15 text-red-300",
};

const conditionLabel = t(`lapak.condition.${condition}` as const);
const statusLabel = t(`lapak.status.${status}` as const);
const isAvailable = status === "available";
---

<article
  class:list={[
    "group relative flex flex-col gap-3 overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-bg-soft)]/40 transition",
    isAvailable && "hover:border-[var(--color-accent)] hover:shadow-lg hover:shadow-[var(--color-accent)]/10",
    !isAvailable && "opacity-60",
  ]}
>
  <a href={href} class="relative block aspect-[4/3] overflow-hidden after:absolute after:inset-0">
    <Image
      src={photos[0]}
      alt={name}
      widths={[320, 480, 640]}
      sizes="(min-width: 768px) 320px, 100vw"
      loading={loading}
      class="h-full w-full object-cover transition group-hover:scale-[1.02]"
    />
  </a>
  <div class="flex flex-col gap-2 px-4 pb-4">
    <header class="flex items-start justify-between gap-2">
      <h3 class="text-base font-semibold tracking-tight">
        {name}
      </h3>
      <span
        class={`shrink-0 rounded-full px-2 py-0.5 text-[10px] font-medium uppercase tracking-wider ${statusClass[status]}`}
      >
        {statusLabel}
      </span>
    </header>
    <div class="flex items-baseline gap-2">
      <span class="text-lg font-semibold text-[var(--color-fg)]">{formatIDR(price)}</span>
      {
        negotiable && (
          <span class="rounded-full border border-[var(--color-border)] px-1.5 py-0.5 font-mono text-[10px] text-[var(--color-fg-soft)]">
            {t("lapak.price.negotiable")}
          </span>
        )
      }
    </div>
    <p class="text-sm text-[var(--color-fg-soft)]">{tagline}</p>
    <footer class="mt-1 flex items-center justify-between text-xs text-[var(--color-fg-soft)]">
      <span class="font-mono">{conditionLabel}</span>
    </footer>
  </div>
</article>
