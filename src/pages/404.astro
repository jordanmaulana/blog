---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getLangFromUrl, localizedPath, useTranslations } from "~/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title="404 — Jordan Maulana">
  <section class="flex min-h-[60vh] flex-col items-start justify-center gap-4 py-20">
    <p class="font-mono text-xs uppercase tracking-[0.25em] text-[var(--color-accent)]">404</p>
    <h1 class="text-balance text-4xl font-semibold tracking-tight md:text-5xl">Lost in the stack trace.</h1>
    <p class="max-w-prose text-[var(--color-fg-soft)]">
      This page doesn't exist — or it moved when I refactored. Head back to the homepage and try again.
    </p>
    <a
      href={localizedPath(lang, "/")}
      class="rounded-full bg-[var(--color-accent)] px-4 py-2 text-sm font-medium text-[var(--color-accent-fg)] transition hover:opacity-90"
    >
      ← {t("nav.home")}
    </a>
  </section>
</BaseLayout>
