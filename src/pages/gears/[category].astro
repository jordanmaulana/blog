---
import BaseLayout from "~/layouts/BaseLayout.astro";
import GearCard from "~/components/GearCard.astro";
import GearCategoryNav from "~/components/GearCategoryNav.astro";
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations } from "~/i18n/utils";
import { getOgImageMetadata } from "~/lib/og-lookup";
import { getUniqueCategories, slugifyCategory } from "~/lib/gear-categories";

export async function getStaticPaths() {
  const gears = await getCollection("gears");
  const categories = getUniqueCategories(gears);
  return categories.map((category) => ({
    params: { category: slugifyCategory(category) },
    props: { category },
  }));
}

interface Props {
  category: string;
}

const { category } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allGears = (await getCollection("gears")).sort(
  (a, b) => a.data.order - b.data.order,
);
const categories = getUniqueCategories(allGears);
const gears = allGears.filter((g) => g.data.category === category);

const cards = gears.map((entry) => ({
  entry,
  ogImage: getOgImageMetadata(entry.data.url),
}));
---

<BaseLayout title={`${t("nav.gears")} — ${category} — Jordan Maulana`}>
  <section class="space-y-8 py-16">
    <header class="space-y-2">
      <p class="font-mono text-xs uppercase tracking-[0.25em] text-[var(--color-accent)]">{t("nav.gears")}</p>
      <h1 class="text-balance text-4xl font-semibold tracking-tight md:text-5xl">{t("section.gears")} — {category}</h1>
      <p class="max-w-prose text-[var(--color-fg-soft)]">{t("section.gears.sub")}</p>
    </header>
    <GearCategoryNav lang={lang} categories={categories} activeCategory={category} />
    {
      cards.length === 0 ? (
        <p class="text-sm text-[var(--color-fg-soft)]">{t("gears.empty")}</p>
      ) : (
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {cards.map(({ entry, ogImage }) => <GearCard entry={entry} ogImage={ogImage} />)}
        </div>
      )
    }
  </section>
</BaseLayout>
