---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { formatDate, getLangFromUrl, localizedPath, useTranslations } from "~/i18n/utils";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.mdx?$/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={`${post.data.title} — Jordan Maulana`} description={post.data.description}>
  <article class="space-y-8 py-12">
    <a
      href={localizedPath(lang, "/blog")}
      class="inline-block text-sm text-[var(--color-fg-soft)] transition hover:text-[var(--color-fg)]"
    >
      {t("blog.back")}
    </a>

    <header class="space-y-3">
      <h1 class="text-balance text-4xl font-semibold tracking-tight md:text-5xl">{post.data.title}</h1>
      <p class="max-w-prose text-lg text-[var(--color-fg-soft)]">{post.data.description}</p>
      <p class="font-mono text-xs text-[var(--color-fg-soft)]">
        {t("blog.published")} {formatDate(post.data.pubDate, lang)}
        {post.data.updatedDate && ` · ${t("blog.updated")} ${formatDate(post.data.updatedDate, lang)}`}
      </p>
      {
        post.data.tags.length > 0 && (
          <ul class="flex flex-wrap gap-1.5">
            {post.data.tags.map((tag) => (
              <li class="rounded-full border border-[var(--color-border)] px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-[var(--color-fg-soft)]">
                #{tag}
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose prose-invert max-w-none prose-headings:font-semibold prose-headings:tracking-tight prose-a:text-[var(--color-accent)] prose-strong:text-[var(--color-fg)] prose-code:rounded prose-code:bg-[var(--color-bg-soft)] prose-code:px-1 prose-code:py-0.5">
      <Content />
    </div>
  </article>
</BaseLayout>
