---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import { getLangFromUrl, localizedPath, useTranslations } from "~/i18n/utils";
import { formatIDR } from "~/utils/format";
import { socials } from "~/data/socials";

export async function getStaticPaths() {
  const items = await getCollection("lapak");
  return items.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { name, tagline, price, negotiable, condition, status, photos } =
  item.data;

const ig = socials.find((s) => s.label === "Instagram")?.url;
const threads = socials.find((s) => s.label === "Threads")?.url;

const statusClass: Record<typeof status, string> = {
  available: "bg-accent/15 text-accent",
  reserved: "bg-yellow-400/15 text-yellow-300",
  sold: "bg-red-400/15 text-red-300",
};

const conditionLabel = t(`lapak.condition.${condition}` as const);
const statusLabel = t(`lapak.status.${status}` as const);
const isAvailable = status === "available";
const [cover, ...rest] = photos;
---

<BaseLayout title={`${name} — Lapak`} description={tagline}>
  <article class="space-y-8 py-12">
    <a
      href={localizedPath(lang, "/lapak")}
      class="inline-block text-sm text-fg-soft transition hover:text-fg"
    >
      {t("lapak.back")}
    </a>

    <div
      class="overflow-hidden rounded-(--radius-card) border border-border bg-bg-soft/40"
    >
      <Image
        src={cover}
        alt={name}
        widths={[640, 960, 1280]}
        sizes="(min-width: 768px) 768px, 100vw"
        loading="eager"
        class="max-h-[60vh] w-full object-cover"
      />
    </div>

    {
      rest.length > 0 && (
        <div class="flex gap-3 overflow-x-auto pb-2">
          {rest.map((photo) => (
            <Image
              src={photo}
              alt={name}
              widths={[160, 240]}
              sizes="160px"
              class="h-32 w-40 shrink-0 rounded-(--radius-card) border border-border object-cover"
            />
          ))}
        </div>
      )
    }

    <header class="space-y-4">
      <div
        class="flex flex-wrap items-center gap-2 font-mono text-xs uppercase tracking-[0.25em]"
      >
        <span class={`rounded-full px-2 py-0.5 ${statusClass[status]}`}
          >{statusLabel}</span
        >
        <span
          class="rounded-full border border-border px-2 py-0.5 text-fg-soft"
        >
          {conditionLabel}
        </span>
      </div>
      <h1
        class="text-balance text-4xl font-semibold tracking-tight md:text-5xl"
      >
        {name}
      </h1>
      <p class="max-w-prose text-lg text-fg-soft">{tagline}</p>
      <div class="flex flex-wrap items-baseline gap-3">
        <span class="text-3xl font-semibold text-fg">{formatIDR(price)}</span>
        {
          negotiable && (
            <span class="rounded-full border border-border px-2 py-0.5 font-mono text-xs text-fg-soft">
              {t("lapak.price.negotiable")}
            </span>
          )
        }
      </div>

      {
        isAvailable ? (
          <div class="flex flex-wrap gap-3 pt-2">
            {ig && (
              <a
                href={ig}
                target="_blank"
                rel="noreferrer"
                class="rounded-full bg-accent px-4 py-2 text-sm font-medium text-accent-fg transition hover:opacity-90"
              >
                {t("lapak.contact.ig")}
              </a>
            )}
            {threads && (
              <a
                href={threads}
                target="_blank"
                rel="noreferrer"
                class="rounded-full border border-border px-4 py-2 text-sm font-medium transition hover:border-accent hover:text-accent"
              >
                {t("lapak.contact.threads")}
              </a>
            )}
          </div>
        ) : (
          <div class="rounded-(--radius-card) border border-border bg-bg-soft/60 px-4 py-3 text-sm text-fg-soft">
            {status === "sold"
              ? t("lapak.sold.banner")
              : t("lapak.reserved.banner")}
          </div>
        )
      }
    </header>

    <div
      class="prose prose-invert max-w-none prose-headings:font-semibold prose-headings:tracking-tight prose-a:text-accent prose-strong:text-fg prose-code:rounded prose-code:bg-bg-soft prose-code:px-1 prose-code:py-0.5"
    >
      <Content />
    </div>
  </article>
</BaseLayout>
